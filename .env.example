# Copy to .env (git-ignored; never commit it).

# The team setup: GPT-6 through the OpenAI API, for both the agent and the simulated user.
# Use the exact model name; it is recorded in each run's config.json.
LLM_PROVIDER=openai
LLM_MODEL=<exact GPT-6 model name>
OPENAI_API_KEY=<your key>

# Backup while building/testing, no key needed (slow on a laptop CPU, too weak for real runs):
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3.5-studio

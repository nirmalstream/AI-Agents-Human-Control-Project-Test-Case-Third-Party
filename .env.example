# Copy to .env (git-ignored; never commit it) and fill in the two values below.

# The team setup: GPT-6 through the OpenAI API, for both the agent and the simulated user.
# Use the exact model name; it is recorded in each run's config.json.
LLM_PROVIDER=openai
LLM_MODEL=<exact GPT-6 model name>
OPENAI_API_KEY=<your key>

# No key yet? Don't create .env at all: the agent then uses local Ollama (run `ollama pull qwen3.5:4b` once).
# Or replace the three lines above with these two:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3.5:4b
